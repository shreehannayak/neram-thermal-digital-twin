<Project Sdk="Microsoft.NET.Sdk">
  <!-- COMPILE-CHECK ONLY. Minimal signatures of the Unity 6 APIs used by NERAM (UnityEngine, UIElements, URP, UnityEditor),
       written from the public documentation. No behaviour. Lets CI catch typos/type errors without a Unity licence.
       A successful build here does NOT prove the code compiles in Unity: open the project in Unity 6 LTS for that. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>UnityStubs</AssemblyName>
    <NoWarn>CS0067;CS0649;CS0169;CS0414;CS1998;CS8632</NoWarn>
  </PropertyGroup>
</Project>
