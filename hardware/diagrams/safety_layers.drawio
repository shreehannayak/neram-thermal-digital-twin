<mxfile host="make_diagrams.py"><diagram name="safety_layers" id="safety_layers"><mxGraphModel dx="1500" dy="900" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="900" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Layer 3: supervisory controller (software; Suchitha)&#xa;Python fallback for MATLAB/Simulink (not available)&#xa;derate at t_mod_derate_degC; trip at t_mod_trip_degC&#xa;fault latch; SAFETY_SHUTDOWN sets Heat_i = 0, master_enable = 0" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#e3ecf7;strokeColor=#3d6da8;strokeWidth=1.6;fontColor=#1d1d1d;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="640" height="150" as="geometry"/></mxCell><mxCell id="c4" value="Layer 2: MCU firmware (Shreehan)&#xa;firmware limits; independent watchdog (wdt_timeout_ms, TBD)&#xa;host-heartbeat timeout: all heaters OFF&#xa;stuck-on detection from current sense" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#fbf0d6;strokeColor=#a8801f;strokeWidth=1.6;fontColor=#1d1d1d;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="640" height="150" as="geometry"/></mxCell><mxCell id="c5" value="Layer 1: hardware cutoff (no firmware; Shreehan)&#xa;comparator on its own NTC per channel at t_hw_cutoff_degC (TBD)&#xa;latched until manual RESET&#xa;works with the MCU halted" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f9e0dc;strokeColor=#b2402f;strokeWidth=1.6;fontColor=#1d1d1d;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="510" width="640" height="150" as="geometry"/></mxCell><mxCell id="c6" value="Master safety switch&#xa;in series with all four channels&#xa;default open (relay coil off)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f9e0dc;strokeColor=#b2402f;strokeWidth=1.6;fontColor=#1d1d1d;fontSize=15;" vertex="1" parent="1"><mxGeometry x="960" y="200" width="480" height="110" as="geometry"/></mxCell><mxCell id="c7" value="Channel switches CH1 to CH4&#xa;default off (gate pull-down)&#xa;low-side MOSFET per channel" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#e2f1e2;strokeColor=#3f8a42;strokeWidth=1.6;fontColor=#1d1d1d;fontSize=15;" vertex="1" parent="1"><mxGeometry x="960" y="400" width="480" height="110" as="geometry"/></mxCell><mxCell id="c8" value="Heater modules&#xa;hands CH1, CH2; feet CH3, CH4" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f6e7d6;strokeColor=#a86420;strokeWidth=1.6;fontColor=#1d1d1d;fontSize=15;" vertex="1" parent="1"><mxGeometry x="960" y="590" width="480" height="90" as="geometry"/></mxCell><mxCell id="c9" value="Threshold ordering (FROZEN; values TBD, never guessed)&#xa;t_mod_derate_degC  &lt;  t_mod_trip_degC  &lt;  t_hw_cutoff_degC  &lt;=  t_surface_limit_degC" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#f2f2f2;strokeColor=#666666;strokeWidth=1.6;fontColor=#1d1d1d;fontSize=15;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="1400" height="80" as="geometry"/></mxCell><mxCell id="c10" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=0;rounded=0;strokeColor=#1d1d1d;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="360" y="240" as="sourcePoint"/><mxPoint x="360" y="300" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="Heat_i = 0, master_enable = 0 (USB)" style="text;html=0;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;fontSize=13;fontColor=#1d1d1d;" vertex="1" parent="1"><mxGeometry x="382.5" y="261.0" width="315" height="18" as="geometry"/></mxCell><mxCell id="c12" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=0;rounded=0;strokeColor=#1d1d1d;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="345" as="sourcePoint"/><mxPoint x="960" y="255" as="targetPoint"/><Array as="points"><mxPoint x="800" y="345"/><mxPoint x="800" y="255"/></Array></mxGeometry></mxCell><mxCell id="c13" value="opens" style="text;html=0;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;fontSize=13;fontColor=#1d1d1d;" vertex="1" parent="1"><mxGeometry x="777.5" y="291.0" width="45" height="18" as="geometry"/></mxCell><mxCell id="c14" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=0;rounded=0;strokeColor=#1d1d1d;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="405" as="sourcePoint"/><mxPoint x="960" y="455" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c15" value="PWM off" style="text;html=0;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;fontSize=13;fontColor=#1d1d1d;" vertex="1" parent="1"><mxGeometry x="808.5" y="411.0" width="63" height="18" as="geometry"/></mxCell><mxCell id="c16" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=0;rounded=0;strokeColor=#1d1d1d;strokeWidth=1.4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="585" as="sourcePoint"/><mxPoint x="960" y="290" as="targetPoint"/><Array as="points"><mxPoint x="880" y="585"/><mxPoint x="880" y="290"/></Array></mxGeometry></mxCell><mxCell id="c17" value="opens + latches" style="text;html=0;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;fontSize=13;fontColor=#1d1d1d;" vertex="1" parent="1"><mxGeometry x="812.5" y="531.0" width="135" height="18" as="geometry"/></mxCell><mxCell id="c18" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=0;rounded=0;strokeColor=#1d1d1d;strokeWidth=1.4;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="310" as="sourcePoint"/><mxPoint x="1200" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c19" value="24 V bus" style="text;html=0;align=center;verticalAlign=middle;labelBackgroundColor=#ffffff;fontSize=13;fontColor=#1d1d1d;" vertex="1" parent="1"><mxGeometry x="1214.0" y="346.0" width="72" height="18" as="geometry"/></mxCell><mxCell id="c20" style="endArrow=block;endFill=1;startArrow=none;startFill=1;html=0;rounded=0;strokeColor=#1d1d1d;strokeWidth=1.4;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1200" y="510" as="sourcePoint"/><mxPoint x="1200" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="Safety layers: each layer can remove heater power without the layers above it" style="text;html=0;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1d1d1d;" vertex="1" parent="1"><mxGeometry x="24" y="22" width="693" height="24" as="geometry"/></mxCell><mxCell id="c22" value="Default state with no power, MCU in reset or host lost: master switch open and every channel switch off." style="text;html=0;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#1d1d1d;" vertex="1" parent="1"><mxGeometry x="24" y="823" width="936" height="24" as="geometry"/></mxCell><mxCell id="c23" value="Proof-of-concept prototype, not a medical device. All hardware is SIMULATED in the demo; no hardware has been built. PROVISIONAL parts per bom/electrical_bom.csv." style="text;html=0;align=left;verticalAlign=middle;fontSize=13;fontStyle=0;fontColor=#1d1d1d;" vertex="1" parent="1"><mxGeometry x="24" y="853" width="1458" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
